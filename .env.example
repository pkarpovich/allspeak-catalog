# Static bearer token for admin endpoints (generate with: openssl rand -hex 32)
AUTH_ADMIN_TOKEN=
# Static bearer token for read endpoints (generate with: openssl rand -hex 32)
AUTH_READ_TOKEN=
# Cloudflare R2 access key id
CF_ACCESS_KEY_ID=
# Cloudflare R2 secret access key
CF_ACCESS_SECRET=
# Cloudflare R2 S3 endpoint (https://<account>.r2.cloudflarestorage.com)
CF_ENDPOINT=
# Cloudflare R2 bucket name
CF_BUCKET=
# SQLite database file path
DB_PATH=/data/catalog.db
# HTTP listen address
LISTEN_ADDR=:8080
# Public domain for the Traefik router (compose-level only)
DOMAIN=
